# Copy to .env and fill in real values. Never commit .env.

# --- Login ---
# Single password for the whole site (you are the only user).
APP_PASSWORD=james
# Random string used to sign the session cookie. e.g. `openssl rand -hex 32`
SESSION_SECRET=

# --- LLM (OpenRouter) ---
# Model profiles only store the NAME of this variable, never the key itself.
OPENROUTER_API_KEY=

# --- Server ---
PORT=8787
# 127.0.0.1 = only this computer. Use 0.0.0.0 to reach it from other devices (e.g. via Tailscale).
HOST=127.0.0.1
# Set to 1 only when served over HTTPS (Caddy / Cloudflare Tunnel).
COOKIE_SECURE=0
# Safety valve against runaway bills: max generations per day (0 = unlimited).
DAILY_REQUEST_LIMIT=300
# Set to 1 to log prompts for debugging. Off by default (privacy).
DEBUG_MODE=0
