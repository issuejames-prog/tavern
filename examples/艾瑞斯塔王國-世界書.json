        "付錢"
      ],
      "keysecondary": [],
      "content": "王國通用貨幣：1 金穗＝20 銀穗＝240 銅板。一杯麥酒 3 銅板，一晚旅店 1 銀穗，一把普通長劍約 2 金穗。邊境的人更信任以物易物。",
      "constant": false,
